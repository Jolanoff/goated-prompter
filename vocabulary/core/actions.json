{
  "spec": 1,
  "entries": [
    {
      "id": "core:action.hold",
      "category": "action",
      "name": "Hold an object",
      "description": "Held in one hand; any other action on the same item uses that same hand.",
      "aliases": [
        "hold"
      ],
      "components": {
        "participants": {
          "slots": {
            "holder": {
              "count": 1,
              "kind": "being"
            },
            "item": {
              "count": 1,
              "kind": "object"
            }
          }
        },
        "requirements": {
          "participants": {
            "holder": {
              "all_of": [
                "core:limb.hand"
              ]
            },
            "item": {
              "all_of": [
                "core:item.handheld"
              ]
            }
          }
        },
        "claims": {
          "holder": [
            {
              "resource": "core:limb.hand",
              "count": 1,
              "mode": "exclusive",
              "purpose": "hold",
              "key": "hold:{item}"
            }
          ]
        }
      }
    },
    {
      "id": "core:action.hug",
      "category": "action",
      "name": "Hug",
      "description": "Arms wrapped around each other's back, chests close, facing each other.",
      "aliases": [
        "embrace",
        "cuddle"
      ],
      "components": {
        "participants": {
          "slots": {
            "a": {
              "count": 1,
              "kind": "being"
            },
            "b": {
              "count": 1,
              "kind": "being"
            }
          }
        },
        "requirements": {
          "participants": {
            "a": {
              "all_of": [
                "core:limb.arm"
              ]
            },
            "b": {
              "all_of": [
                "core:limb.arm"
              ]
            }
          }
        },
        "spatial": {
          "participants": {
            "a": {
              "facing": {
                "toward": "b"
              },
              "anchors": [
                {
                  "relation": "in_front",
                  "of": "b",
                  "distance": "contact"
                }
              ]
            },
            "b": {
              "facing": {
                "toward": "a"
              }
            }
          },
          "access": [
            {
              "from": "a",
              "using": "core:limb.arm",
              "to": "b",
              "regions": [
                "core:anatomy.back"
              ],
              "kind": "touch"
            },
            {
              "from": "b",
              "using": "core:limb.arm",
              "to": "a",
              "regions": [
                "core:anatomy.back"
              ],
              "kind": "touch"
            }
          ]
        },
        "claims": {
          "a": [
            {
              "resource": "core:limb.arm",
              "count": 2,
              "mode": "shared",
              "purpose": "contact"
            }
          ],
          "b": [
            {
              "resource": "core:limb.arm",
              "count": 2,
              "mode": "shared",
              "purpose": "contact"
            }
          ]
        }
      }
    },
