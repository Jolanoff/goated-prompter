{
  "spec": 1,
  "entries": [
    {
      "id": "general:action.object_interaction",
      "category": "action",
      "name": "Object interaction template",
      "abstract": true,
      "components": {
        "participants": {"slots": {"actor": {"count": 1, "kind": "being"}, "item": {"count": 1, "kind": "object"}}}
      }
    },
    {
      "id": "general:action.wear",
      "category": "action",
      "name": "Wear an item",
      "description": "An item worn by its actor; descendants can declare the occupied body regions.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {"requirements": {"participants": {"item": {"all_of": ["core:item.wearable"]}}}}
    },
    {
      "id": "general:action.attach",
      "category": "action",
      "name": "Attach an item",
      "description": "An actor attaches an item; descendants declare the attachment point and resources they need.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {}
    },
    {
      "id": "general:action.insert",
      "category": "action",
      "name": "Insert an item",
      "description": "An actor inserts an item; descendants declare the destination, access and occupied resources.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {}
    },
    {
      "id": "general:action.wield",
      "category": "action",
      "name": "Wield a handheld item",
      "description": "An actor uses one hand to wield an item; holding that same item shares the allocation key.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {
        "requirements": {"participants": {"actor": {"all_of": ["core:limb.hand"]}, "item": {"all_of": ["core:item.handheld"]}}},
        "claims": {"actor": [{"resource": "core:limb.hand", "count": 1, "mode": "exclusive", "purpose": "wield", "key": "hold:{item}"}]}
      }
    },
    {
      "id": "general:action.support",
      "category": "action",
      "name": "Use an item for support",
      "description": "An actor is supported by an item; descendants declare posture, attachment and load where known.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {"requirements": {"participants": {"item": {"all_of": ["core:surface"]}}}}
    },
    {
      "id": "general:action.sit_on",
      "category": "action",
      "name": "Sit on an item",
      "description": "An actor sits on an item's seating surface.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {
        "requirements": {"participants": {"item": {"all_of": ["core:surface.seat"]}}},
        "spatial": {"participants": {"actor": {"posture": "general:posture.sitting", "anchors": [{"relation": "on", "of": "item"}]}}}
      }
    },
    {
      "id": "general:action.lie_on",
      "category": "action",
      "name": "Lie on an item",
      "description": "An actor lies on a wide supporting surface; the body orientation is left open.",
      "abstract": true,
      "extends": ["general:action.object_interaction"],
      "components": {
        "requirements": {"participants": {"item": {"all_of": ["core:surface.wide"]}}},
        "spatial": {"participants": {"actor": {"anchors": [{"relation": "on", "of": "item"}]}}}
      }
    },
    {
      "id": "general:action.hold",
      "category": "action",
      "name": "Hold an object",
      "description": "Held in one hand; any other action on the same item uses that same hand.",
      "aliases": [
        "hold"
      ],
      "components": {
        "participants": {
          "slots": {
            "holder": {
              "count": 1,
              "kind": "being"
            },
            "item": {
              "count": 1,
              "kind": "object"
            }
          }
        },
        "requirements": {
          "participants": {
            "holder": {
              "all_of": [
                "core:limb.hand"
              ]
            },
            "item": {
              "all_of": [
                "core:item.handheld"
              ]
            }
          }
        },
        "claims": {
          "holder": [
            {
              "resource": "core:limb.hand",
              "count": 1,
              "mode": "exclusive",
              "purpose": "hold",
              "key": "hold:{item}"
            }
          ]
        },
        "visibility": {
          "participants": {
            "holder": {
              "regions": [
                "core:limb.hand"
              ]
            }
          }
        }
      }
    },
    {
      "id": "general:action.hug",
      "category": "action",
      "name": "Hug",
      "description": "Arms wrapped around each other's back, chests close, facing each other.",
      "aliases": [
        "embrace",
        "cuddle"
      ],
      "components": {
        "participants": {
          "slots": {
            "a": {
              "count": 1,
              "kind": "being"
            },
            "b": {
              "count": 1,
              "kind": "being"
            }
          }
        },
        "requirements": {
          "participants": {
            "a": {
              "all_of": [
                "core:limb.arm"
              ]
            },
            "b": {
              "all_of": [
                "core:limb.arm"
              ]
            }
          }
        },
        "spatial": {
          "participants": {
            "a": {
              "facing": {
                "toward": "b"
              },
              "anchors": [
                {
                  "relation": "in_front",
                  "of": "b",
                  "distance": "contact"
                }
              ]
            },
            "b": {
              "facing": {
                "toward": "a"
              }
            }
          },
          "access": [
            {
              "from": "a",
              "using": "core:limb.arm",
              "to": "b",
              "regions": [
                "core:anatomy.back"
              ],
              "kind": "touch"
            },
            {
              "from": "b",
              "using": "core:limb.arm",
              "to": "a",
              "regions": [
                "core:anatomy.back"
              ],
              "kind": "touch"
            }
          ]
        },
        "claims": {
          "a": [
            {
              "resource": "core:limb.arm",
              "count": 2,
              "mode": "shared",
              "purpose": "contact"
            }
          ],
          "b": [
            {
              "resource": "core:limb.arm",
              "count": 2,
              "mode": "shared",
              "purpose": "contact"
            }
          ]
        }
      }
    },
    {
      "id": "general:action.kiss",
      "category": "action",
      "name": "Kiss",
      "description": "Lips meet; faces turned toward each other at close range.",
      "components": {
        "participants": {
          "slots": {
            "a": {
              "count": 1,
              "kind": "being"
            },
            "b": {
              "count": 1,
              "kind": "being"
            }
          }
        },
        "requirements": {
          "participants": {
            "a": {
              "all_of": [
                "core:anatomy.mouth"
              ]
            },
            "b": {
              "all_of": [
                "core:anatomy.mouth"
              ]
            }
          }
        },
        "spatial": {
          "participants": {
            "a": {
              "facing": {
                "toward": "b"
              },
              "anchors": [
                {
                  "relation": "in_front",
                  "of": "b",
                  "distance": "contact"
                }
              ]
            },
            "b": {
              "facing": {
                "toward": "a"
              }
            }
          },
          "access": [
            {
              "from": "a",
              "using": "core:anatomy.mouth",
              "to": "b",
              "regions": [
                "core:anatomy.mouth"
              ],
              "kind": "touch"
            }
          ]
        },
        "claims": {
          "a": [
            {
              "resource": "core:anatomy.mouth",
              "count": 1,
              "mode": "exclusive",
              "purpose": "contact"
            }
          ],
          "b": [
            {
              "resource": "core:anatomy.mouth",
              "count": 1,
              "mode": "exclusive",
              "purpose": "contact"
            }
          ]
        },
        "visibility": {
          "contact": true
        }
      }
    },
    {
      "id": "general:action.hold_hands",
      "category": "action",
      "name": "Holding hands",
      "description": "One hand of each clasped together; the free hands stay free.",
      "components": {
        "participants": {
          "slots": {
            "a": {
              "count": 1,
              "kind": "being"
            },
            "b": {
              "count": 1,
              "kind": "being"
            }
          }
        },
        "requirements": {
          "participants": {
            "a": {
              "all_of": [
                "core:limb.hand"
              ]
            },
            "b": {
              "all_of": [
                "core:limb.hand"
              ]
            }
          }
        },
        "spatial": {
          "access": [
            {
              "from": "a",
              "using": "core:limb.hand",
              "to": "b",
              "regions": [
                "core:limb.hand"
              ],
              "kind": "touch"
            }
          ]
        },
        "claims": {
          "a": [
            {
              "resource": "core:limb.hand",
              "count": 1,
              "mode": "exclusive",
              "purpose": "contact"
            }
          ],
          "b": [
            {
              "resource": "core:limb.hand",
              "count": 1,
              "mode": "exclusive",
              "purpose": "contact"
            }
          ]
        },
        "visibility": {
          "contact": true
        }
      }
    }
  ]
}
