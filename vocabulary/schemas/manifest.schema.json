{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goated-prompter.local/vocabulary/manifest.schema.json",
  "title": "Vocabulary pack manifest",
  "description": "manifest.json of a vocabulary pack. See SPEC.md section 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "id", "name", "version", "rating", "files"],
  "properties": {
    "spec": { "const": 1 },
    "id": { "$ref": "#/$defs/packId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "maxLength": 2000 },
    "authors": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true },
    "license": { "type": "string", "maxLength": 80 },
    "rating": { "$ref": "#/$defs/rating" },
    "activation": {
      "enum": ["theme", "content", "always"],
      "default": "theme",
      "description": "When the pack's entries may be offered as ideas the request did not name. theme (default): only when the request reaches the pack's theme. content: also when an NSFW request's content level matches an entry's rating (not for General packs). Named entries are always found."
    },
    "themes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true,
      "maxItems": 24,
      "description": "Words and phrases a brief uses to ask for this pack's theme as a whole, besides its name (e.g. \"dragons\", \"fantasy creature\"). Matched as ordered phrases. A specific concept belongs on entries (names, aliases, tags), not here. The description is never used to find the pack."
    },
    "requires": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/packId" },
      "additionalProperties": { "$ref": "#/$defs/versionRange" }
    },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/packId" }, "uniqueItems": true },
    "component_types": {
      "description": "Reusable interfaces derived from existing Core contracts. Pack-defined names use pack_id:name; dependencies may extend them without engine code.",
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["base"],
        "properties": {
          "base": {"type": "string", "minLength": 1, "maxLength": 120},
          "dimension": {"enum": ["framing", "camera_angle", "composition", "lighting", "atmosphere"]}
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.json$" }
    }
  },
  "$defs": {
    "packId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "versionRange": {
      "type": "string",
      "pattern": "^(>=|>|<=|<|=)?[0-9]+\\.[0-9]+\\.[0-9]+( (>=|>|<=|<)[0-9]+\\.[0-9]+\\.[0-9]+)?$"
    },
    "rating": { "enum": ["general", "mature", "adult"] }
  }
}
