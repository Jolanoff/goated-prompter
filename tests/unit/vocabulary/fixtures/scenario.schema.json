{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stress-test scenario (test fixture)",
  "description": "Entries bound to a cast, with the status the Phase 3 resolver must report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "packs",
    "cast",
    "use",
    "expect"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "body": {
            "type": "string"
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "complete_for": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "item": {
            "type": "string"
          },
          "complete_for": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "space": {
      "type": "string"
    },
    "use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "bind"
        ],
        "properties": {
          "entry": {
            "type": "string"
          },
          "bind": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              ]
            }
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "because"
      ],
      "properties": {
        "status": {
          "enum": [
            "feasible",
            "eligible",
            "unknown",
            "conflict"
          ]
        },
        "because": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "object"
        }
      }
    }
  }
}
