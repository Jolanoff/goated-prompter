        "body": {
          "provides": [
            "fantasy:magic.caster"
          ]
        }
      }
    },
    {
      "id": "fantasy:item.staff",
      "category": "item",
      "name": "Staff",
      "components": {
        "object": {
          "provides": [
            "core:item.handheld",
            "fantasy:magic.focus"
          ],
          "size": "medium",
          "hands": 1
        }
      }
    },
    {
      "id": "fantasy:action.cast_on",
      "category": "action",
      "name": "Cast a spell on someone",
      "components": {
        "participants": {
          "slots": {
            "caster": {
              "count": 1,
              "kind": "being"
            },
            "target": {
              "count": 1,
              "kind": "being"
            },
            "focus": {
