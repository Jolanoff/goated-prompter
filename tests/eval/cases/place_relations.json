{
 "about": "Tuning requests for tests/eval/place_relations.py: requests that place their subjects relative to things (landmarks, furniture, natural features, people). relations: what Understanding should keep (anchor: the thing a subject is placed relative to; within: true when the anchor holds the subject, so it is where the image happens). acceptable: Spaces groups where the arrangement holds; breaks: groups that would break it (inside an anchor the subject is outside of, or away from the one it is in).",
 "cases": [
  {"request": "a dragon in front of a castle", "world": "fantasy",
   "relations": [{"anchor": "castle", "within": false}],
   "acceptable": ["mountain and meadow", "forest", "medieval village", "ruins and temples", "lake", "river",
                  "enchanted nature", "snow", "desert"],
   "breaks": ["castle", "dungeon", "tavern and inn"]},
  {"request": "one man standing on the left, long table in the middle, one standing on the right", "world": "everyday",
   "relations": [{"anchor": "table", "within": false}],
   "acceptable": ["office", "home office", "cafe and diner", "kitchen", "party", "library", "school", "living room",
                  "workshop and garage", "lab and server room", "craft studio", "art and photo studio", "backyard",
                  "restaurant kitchen", "museum", "lobby and elevator"],
   "breaks": ["beach", "swimming pool", "car and bus", "airplane", "train", "boat", "snow", "plain backdrop"]},
  {"request": "a woman sitting on a bench in front of a fountain in a park", "world": "everyday",
   "relations": [{"anchor": "bench", "within": true}, {"anchor": "fountain", "within": false},
                 {"anchor": "park", "within": true}],
   "acceptable": ["park"], "breaks": ["kitchen", "office", "bedroom", "city street", "beach", "forest"]},
  {"request": "a cat sleeping under the kitchen table", "world": "everyday",
   "relations": [{"anchor": "kitchen table", "within": false}],
   "acceptable": ["kitchen"], "breaks": ["bedroom", "bathroom", "park", "office", "restaurant kitchen"]},
  {"request": "a knight standing beside a lighthouse", "world": "historical",
   "relations": [{"anchor": "lighthouse", "within": false}],
   "acceptable": ["beach", "mountain and meadow", "medieval village", "river", "lake", "ruins and temples"],
   "breaks": ["castle", "dungeon", "tavern and inn", "sailing ship"]},
  {"request": "two kids playing inside a castle", "world": "fantasy",
   "relations": [{"anchor": "castle", "within": true}],
   "acceptable": ["castle"], "breaks": ["forest", "mountain and meadow", "medieval village", "lake", "river"]},
  {"request": "a man reading behind the counter of a bookshop", "world": "everyday",
   "relations": [{"anchor": "counter", "within": false}, {"anchor": "bookshop", "within": true}],
   "acceptable": ["shopping", "library"], "breaks": ["kitchen", "bar and club", "park", "bedroom", "office"]},
  {"request": "a couple standing between two tall trees at the edge of a lake", "world": "everyday",
   "relations": [{"anchor": "trees", "within": false}, {"anchor": "lake", "within": false}],
   "acceptable": ["lake", "forest", "mountain and meadow", "park"],
   "breaks": ["boat", "swimming pool", "underwater", "city street", "office"]},
  {"request": "a girl hiding behind her father", "world": "everyday",
   "relations": [{"anchor": "father", "within": false}],
   "acceptable": [], "breaks": ["plain backdrop"]}
 ]
}
